#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int a,b,c,d,e,total;
    float avg,percentage  ;
    scanf("%d",&a);
    scanf("%d",&b);
    scanf("%d",&c);
    scanf("%d",&d);
    scanf("%d",&e);
    total=a+b+c+d+e;
    avg=total/5;
    percentage=avg;
    printf("%d %.2f %.2f",total,avg,percentage);
    return 0;
}
