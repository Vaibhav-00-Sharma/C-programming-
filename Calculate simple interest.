#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    float principal, rate, time, interest;
    scanf("%f", &principal);
    scanf("%f", &rate);
    scanf("%f", &time);
    interest = (principal * rate * time) / 100;
    printf("%.2f", interest);  
    return 0;
}
